<ci:SettingsPageBase x:Class="ClassIsland.TimeProgressBar.Views.SettingsPages.TimeProgressBarSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ClassIsland.TimeProgressBar.Views.SettingsPages"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     mc:Ignorable="d"
                     Design.Width="960"
                     Design.Height="500"
                     d:DataContext="{d:DesignInstance local:TimeProgressBarSettingsPage}">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE768;}"
                                 Header="启用进度条"
                                 Description="关闭后将不再在屏幕顶部显示进度条。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC54;}"
                                 Header="进度条宽度"
                                 Description="进度条的粗细，以逻辑像素为单位。进度条最大长度始终为整个屏幕宽度。">
                <fa:SettingsExpander.Footer>
                    <ci:Field VerticalAlignment="Center" Suffix="px">
                        <NumericUpDown MinWidth="120"
                                       Minimum="1"
                                       Maximum="50"
                                       FormatString="0"
                                       Value="{Binding Thickness, Mode=TwoWay}" />
                    </ci:Field>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE72C;}"
                                 Header="流逝方向"
                                 Description="从左往右：空白自左侧吞没进度条，剩余进度条贴屏幕右边缘；从右往左则相反。">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="160"
                              SelectedIndex="{Binding FlowDirectionIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="从左往右" />
                        <ComboBoxItem Content="从右往左" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE790;}"
                                 Header="进度条颜色"
                                 Description="时间点剩余时间多于警示阈值时进度条的颜色。">
                <fa:SettingsExpander.Footer>
                    <ColorPicker Color="{Binding BarColor, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7BA;}"
                                 Header="警示颜色"
                                 Description="距时间点结束不足警示阈值时进度条的颜色。">
                <fa:SettingsExpander.Footer>
                    <ColorPicker Color="{Binding WarningColor, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE81C;}"
                                 Header="警示阈值"
                                 Description="剩余时间不大于该值时切换为警示颜色。">
                <fa:SettingsExpander.Footer>
                    <ci:Field VerticalAlignment="Center" Suffix="秒">
                        <NumericUpDown MinWidth="120"
                                       Minimum="0"
                                       Maximum="3600"
                                       FormatString="0"
                                       Value="{Binding WarningThresholdSeconds, Mode=TwoWay}" />
                    </ci:Field>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7F4;}"
                                 Header="仅在前台窗口全屏或最大化时显示"
                                 Description="开启后，仅当前台窗口处于全屏或最大化状态时才显示进度条。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding OnlyForegroundMaximizedOrFullscreen, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <TextBlock Margin="0,12,0,0"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Text="进度条始终置顶显示在屏幕顶部，长度为当前时间点剩余时间占比乘以屏幕宽度；当前不处于任何时间点时将自动隐藏进度条。" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
